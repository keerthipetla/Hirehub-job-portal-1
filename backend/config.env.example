# HireHub Backend Environment Configuration
# Copy this file to backend/config/config.env and customize as needed

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRE_TIME=7d
COOKIE_EXPIRE_TIME=7

# Cloudinary Configuration
CLOUDINARY_CLIENT_NAME=your_cloudinary_name
CLOUDINARY_CLIENT_API=your_cloudinary_api_key
CLOUDINARY_CLIENT_SECRET=your_cloudinary_api_secret

# Email Configuration (Nodemailer for password reset)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
